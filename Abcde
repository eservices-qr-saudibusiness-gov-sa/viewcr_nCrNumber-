<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WINPRO 360 - Official Real Money Gaming Platform</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        body {
            background-color: #0b131e;
            color: #ffffff;
        }
        header {
            background: #121c29;
            padding: 15px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 2px solid #ffaa00;
            box-shadow: 0 4px 20px rgba(255, 170, 0, 0.2);
            position: sticky;
            top: 0;
            z-index: 1000;
        }
        .logo {
            font-size: 26px;
            font-weight: 900;
            color: #ffffff;
            text-transform: uppercase;
            letter-spacing: 2px;
            text-shadow: 0 0 10px #ffaa00, 0 0 20px #ffaa00;
        }
        .logo span {
            color: #ffaa00;
        }
        .user-panel {
            display: flex;
            align-items: center;
            gap: 15px;
        }
        .balance {
            background: #1b2838;
            padding: 8px 15px;
            border-radius: 6px;
            font-weight: bold;
            color: #00ffcc;
            border: 1px solid #00ffcc55;
        }
        .btn {
            padding: 8px 18px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-weight: bold;
            transition: 0.3s;
        }
        .btn-deposit {
            background: linear-gradient(135deg, #00ffcc, #00b386);
            color: #0b131e;
        }
        .btn-withdraw {
            background: linear-gradient(135deg, #ff4757, #cc2e3d);
            color: #fff;
        }
        .btn:hover {
            opacity: 0.9;
            transform: scale(1.02);
        }
        .container {
            max-width: 1200px;
            margin: 30px auto;
            padding: 0 20px;
        }
        .banner {
            background: linear-gradient(135deg, #1f2f45, #111a25);
            border: 1px solid #ffaa0055;
            padding: 40px;
            border-radius: 12px;
            text-align: center;
            margin-bottom: 30px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        }
        .banner h1 {
            font-size: 34px;
            margin-bottom: 10px;
            color: #fff;
        }
        .banner h1 span {
            color: #ffaa00;
        }
        .games-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
        }
        .game-card {
            background: #162231;
            border-radius: 12px;
            overflow: hidden;
            text-align: center;
            border: 1px solid #24354a;
            transition: 0.3s;
        }
        .game-card:hover {
            transform: translateY(-5px);
            border-color: #ffaa00;
            box-shadow: 0 5px 20px rgba(255, 170, 0, 0.2);
        }
        .game-img {
            height: 140px;
            background: #111a25;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            color: #ffaa00;
            font-weight: bold;
            border-bottom: 1px solid #24354a;
        }
        .game-info {
            padding: 15px;
        }
        .game-title {
            font-size: 18px;
            margin-bottom: 12px;
            color: #e1e1e1;
        }
        .btn-play {
            background: #ffaa00;
            color: #0b131e;
            width: 100%;
            padding: 10px;
            border: none;
            border-radius: 6px;
            font-weight: bold;
            cursor: pointer;
            transition: 0.3s;
        }
        .btn-play:hover {
            background: #ffbb33;
        }
        /* Modal Styles for Deposit/Withdraw */
        .modal {
            display: none;
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.8);
            justify-content: center;
            align-items: center;
            z-index: 2000;
        }
        .modal-content {
            background: #162231;
            padding: 30px;
            border-radius: 12px;
            width: 100%;
            max-width: 400px;
            border: 1px solid #ffaa00;
            text-align: center;
        }
        .modal-content h2 {
            margin-bottom: 20px;
            color: #ffaa00;
        }
        .modal-content input {
            width: 100%;
            padding: 12px;
            margin-bottom: 15px;
            background: #0b131e;
            border: 1px solid #24354a;
            border-radius: 6px;
            color: #fff;
            font-size: 16px;
        }
        .modal-content button {
            width: 100%;
            padding: 12px;
            background: #ffaa00;
            border: none;
            border-radius: 6px;
            font-weight: bold;
            cursor: pointer;
            color: #0b131e;
            font-size: 16px;
        }
        .close-btn {
            margin-top: 10px;
            background: transparent !important;
            color: #ff4757 !important;
        }
    </style>
</head>
<body>

    <header>
        <div class="logo">WIN<span>PRO</span> 360</div>
        <div class="user-panel">
            <div class="balance" id="userBalance">₨ 5,000.00</div>
            <button class="btn btn-deposit" onclick="openModal('depositModal')">Deposit</button>
            <button class="btn btn-withdraw" onclick="openModal('withdrawModal')">Withdraw</button>
        </div>
    </header>

    <div class="container">
        <div class="banner">
            <h1>Welcome to <span>WINPRO 360</span> Official</h1>
            <p>Real Money Gaming Platform. Play Aviator, Color Prediction & Win Instantly!</p>
        </div>

        <h2 style="margin-bottom: 20px; border-left: 4px solid #ffaa00; padding-left: 10px;">Official Games</h2>
        
        <div class="games-grid">
            <div class="game-card">
                <div class="game-img">🚀 AVIATOR</div>
                <div class="game-info">
                    <div class="game-title">Crash Jet Multiplier</div>
                    <button class="btn-play" onclick="alert('Launching Real Money Aviator Game...')">Play Now</button>
                </div>
            </div>
            <div class="game-card">
                <div class="game-img">🎨 COLOR PREDICTION</div>
                <div class="game-info">
                    <div class="game-title">Win Go 1Min</div>
                    <button class="btn-play" onclick="alert('Launching Color Prediction Game...')">Play Now</button>
                </div>
            </div>
            <div class="game-card">
                <div class="game-img">🎲 LUCKY DICE</div>
                <div class="game-info">
                    <div class="game-title">Roll & Win</div>
                    <button class="btn-play" onclick="alert('Launching Lucky Dice Game...')">Play Now</button>
                </div>
            </div>
            <div class="game-card">
                <div class="game-img">🎰 SLOT MACHINE</div>
                <div class="game-info">
                    <div class="game-title">Royal Spins</div>
                    <button class="btn-play" onclick="alert('Launching Slot Machine...')">Play Now</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Deposit Modal -->
    <div class="modal" id="depositModal">
        <div class="modal-content">
            <h2>Deposit Real Money</h2>
            <input type="number" id="depositAmount" placeholder="Enter Amount (PKR/INR)">
            <input type="text" placeholder="Transaction ID / Receipt No">
            <button onclick="processDeposit()">Submit Deposit</button>
            <button class="close-btn" onclick="closeModal('depositModal')">Cancel</button>
        </div>
    </div>

    <!-- Withdraw Modal -->
    <div class="modal" id="withdrawModal">
        <div class="modal-content">
            <h2>Withdraw Funds</h2>
            <input type="number" placeholder="Enter Withdrawal Amount">
            <input type="text" placeholder="EasyPaisa / JazzCash / Bank Account">
            <button onclick="alert('Withdrawal Request Sent to Admin Panel for Approval!')">Request Withdrawal</button>
            <button class="close-btn" onclick="closeModal('withdrawModal')">Cancel</button>
        </div>
    </div>

    <script>
        function openModal(modalId) {
            document.getElementById(modalId).style.display = 'flex';
        }
        function closeModal(modalId) {
            document.getElementById(modalId).style.display = 'none';
        }
        function processDeposit() {
            let amt = document.getElementById('depositAmount').value;
            if(amt) {
                alert('Deposit of ₨ ' + amt + ' submitted successfully! Awaiting Admin Approval.');
                closeModal('depositModal');
            } else {
                alert('Please enter a valid amount');
            }
        }
    </script>

</body>
</html>
